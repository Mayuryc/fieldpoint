{
  "name": "fieldpoint",
  "version": "1.0.0",
  "description": "FieldPoint - sistema de gesti\u00f3n para cancha sint\u00e9tica (Fase 3)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/api.test.js tests/mejoras.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/api.test.js tests/mejoras.test.js",
    "test:selenium": "node --test tests/selenium/crud.test.js",
    "lint": "eslint .",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir",
    "backup": "node scripts/backup.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "selenium-webdriver": "^4.50.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "co.fieldpoint.app",
    "productName": "FieldPoint",
    "directories": {
      "output": "dist"
    },
    "files": [
      "api/**",
      "lib/**",
      "public/**",
      "assets/**",
      "desktop/**",
      "server.js",
      "schema.sql",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "FieldPoint"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}