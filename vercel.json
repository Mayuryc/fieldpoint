{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{schema.sql,assets/**,lib/license-public.pem}",
      "maxDuration": 30
    }
  }
}